# Line endings.
#
# LF in the repository regardless of whose machine committed, so a file does not
# show up as entirely rewritten just because one of us is on Windows and the
# other is not.
* text=auto eol=lf

*.sql  text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf

# Never apply line-ending conversion to a database file. CRLF conversion on
# immunisation2.db would corrupt the supplied data, which is the one file in
# this repository that cannot be regenerated.
*.db binary
*.woff2 binary
